# =========================
# BuildX Claude Video Editor
# .gitignore
# =========================

# macOS
.DS_Store

# Node.js
node_modules/
npm-debug.log*

# Premiere Pro
*.prproj.autosave
*.prlock
*.pek
*.cfa

# Temporary files
*.tmp
*.temp
*.log

# Build outputs
exports/
renders/
gui/evidence/
reframed/
transcription-audio/

# Working media (stored outside Git)
footage/
transcripts/

# Local caches
.cache/
# Ultralytics downloads its segmentation weights into the working directory
# the first time verthor runs. Cached on purpose (avoids a re-download), but
# it is a binary model file, not source.
yolo11n-seg.pt
*.pt


# Environment files
.env
.env.*

# OS/editor
.vscode/
.idea/

# Python cache
__pycache__/
*.pyc

# =========================
# Non-anonymous material
# =========================
# NOTE: these rules only stop NEW files being committed. Anything already
# tracked is unaffected — see the note at the bottom of this file.

# Freeze frames are stills lifted from real customer footage.
**/freeze.png
**/freeze-*.png
**/freeze/

# Customer-identifying stills and reference frames
**/customer-*.png
**/customer-*.jpg

# Local Claude Code settings (previously only covered by a global ignore,
# which does not exist on anyone else's machine)
.claude/settings.local.json

# Hook previews and recordings are generated next to the hook they came from.
hooks/*-preview.png
hooks/*.mov

# Generated per-clone MCP config. It has to hold an absolute path to this
# clone, so it cannot be shared. Generate it with:
#     node scripts/init-mcp-config.mjs
# The tracked template is .mcp.json.example.
.mcp.json

# -------------------------------------------------------------------------
# .gitignore does NOT untrack files that are already committed. To stop
# tracking something that is already in the repo:
#     git rm --cached <path>
# and note that it REMAINS in git history and is still recoverable from an
# earlier commit by anyone who clones. For anything that must never be
# distributed, publish from a repository that never contained it.
# -------------------------------------------------------------------------
